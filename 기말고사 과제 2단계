import streamlit as st
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import joblib

st.set_page_config(layout="wide")
st.title("📊 WHO 기대수명 예측 및 규제 모델 비교 대시보드")

# 모델 및 성능 지표 파일 로드
@st.cache_resource
def load_models():
    m1 = joblib.load('model_linear.pkl')
    m2 = joblib.load('model_poly.pkl')
    m3 = joblib.load('model_ridge.pkl')
    metrics = pd.read_csv('metrics.csv')
    return m1, m2, m3, metrics

m_linear, m_poly, m_ridge, metrics_df = load_models()

# ----------------- [조건 4] 사이드바 입력 및 UI 구성 -----------------
st.sidebar.header("🔧 독립변수(Feature) 입력")

# 선택한 특성 3개: Adult Mortality, BMI, GDP (데이터셋 기반 합리적 범위 설정)
adult_mortality = st.sidebar.slider("Adult Mortality (인구 1,000명당 사망률)", 1, 750, 160, step=1)
bmi = st.sidebar.slider("BMI (체질량지수)", 1.0, 80.0, 38.0, step=0.1)
gdp = st.sidebar.slider("GDP (1인당 국내총생산)", 1, 120000, 7500, step=50)

st.sidebar.markdown("---")
# 모델 선택 인터페이스
selected_model_name = st.sidebar.selectbox("🎯 분석에 사용할 모델 선택", ["Linear", "Poly", "Ridge"])

# ----------------- [조건 3] 각 모델의 성능 비교 화면 구현 -----------------
col1, col2 = st.columns([3, 2])

with col1:
    st.subheader("📈 모델별 성능 평가지표 비교")
    # 항상 화면에 상시 노출되는 DataFrame
    st.dataframe(metrics_df.set_index('Model'), use_container_width=True)
    
    st.markdown("""
    > **💡 관전 포인트:** > * `Poly` 모델은 50개의 적은 데이터에 극도로 과대적합되어 **Train R²은 매우 높지만 Test R²이 음수이거나 극단적으로 낮게** 떨어집니다.
    > * `Ridge` 규제를 적용하면 복잡도(Complexity)는 유지되면서도 **Test R² 성적이 방어**되는 모습을 확인할 수 있습니다.
    """)

with col2:
    st.subheader("📊 Test $R^2$ 점수 시각화")
    fig, ax = plt.subplots(figsize=(5, 4.2))
    # 스타일 세팅
    sns.barplot(x='Model', y='Test R2', data=metrics_df, ax=ax, palette='Set2')
    ax.set_title("Model Comparison (Test R2)", fontsize=12)
    ax.set_ylabel("R2 Score")
    ax.set_xlabel("Model Type")
    plt.xticks(rotation=15)
    st.pyplot(fig)

---
# ----------------- [조건 4] 실시간 동적 예측 결과 출력 -----------------
st.subheader("🔮 실시간 기대수명(Life expectancy) 예측 결과")

# 입력 데이터를 DataFrame 형태로 변환 (학습 당시 컬럼 순서 일치)
input_data = pd.DataFrame([[adult_mortality, bmi, gdp]], columns=['Adult Mortality', 'BMI', 'GDP'])

# 선택한 모델 지정
if selected_model_name == "Linear":
    current_model = m_linear
elif selected_model_name == "Poly":
    current_model = m_poly
else:
    current_model = m_ridge

# 실시간 예측 수행
prediction = current_model.predict(input_data)[0]

# 큰 글씨 및 시각적 효과 배치
st.metric(
    label=f"선택된 모델: {selected_model_name}",
    value=f"{prediction:.2f} 세"
)

# 예측값 비정상 처리 가이드 (과대적합 모델 터짐 방지 알림)
if prediction < 0 or prediction > 120:
    st.error("⚠️ 경고: 규제가 없는 Poly 모델은 과대적합으로 인해 입력값에 따라 터무니없는 예측값을 출력할 수 있습니다.")
